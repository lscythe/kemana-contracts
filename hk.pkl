amends "package://github.com/jdx/hk/releases/download/v2.11.1/hk@2.11.1#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.11.1/hk@2.11.1#/Builtins.pkl"

local staged_checks = new Mapping<String, Step> {
    ["buf-format"] {
        glob = List("**/*.proto")
        fix = "buf format -w"
    }
    ["buf-lint"] = Builtins.buf_lint
    ["trailing-whitespace"] = Builtins.trailing_whitespace
    ["newlines"] = Builtins.newlines
    ["taplo"] = Builtins.taplo_format
    ["yamlfmt"] = Builtins.yamlfmt
}

hooks {
    ["pre-commit"] {
        fix = true
        stash = "git"
        steps = staged_checks
    }
    ["fix"] {
        fix = true
        steps = staged_checks
    }
    ["check"] {
        steps = staged_checks
    }
    ["commit-msg"] {
        steps = new Mapping<String, Step> {
            ["check-commit-scope"] {
                check = "python3 .github/scripts/commit_scope.py {{commit_msg_file}}"
            }
        }
    }
    ["pre-push"] {
        steps = new Mapping<String, Step> {
            ["check-and-test"] {
                check = "mise run check && mise run test"
            }
        }
    }
}
